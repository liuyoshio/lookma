# Copy to .env and fill in. Lookma reads it when it starts; real environment variables win.
# These are the settings a new user needs; every one is in the Configuration table of README.md.

# Turns on voice. Without it (or with LOOKMA_NO_VOICE=1) you type instead, and nothing is sent to OpenAI.
# With it, Lookma listens while it runs and is not paused; pause from the menu bar or with ⌃⌥P.
OPENAI_API_KEY=

# The language you speak, as an ISO code (en, zh, ja, ...). Unset, it is detected.
# LOOKMA_VOICE_LANGUAGE=en

# How you hear the voice: room (speakers, the default) or headset. With a headset, talking over
# the voice cuts it off; in a room it finishes its sentence.
# LOOKMA_AUDIO=room

# The longest a spoken reply can be, in tokens.
# LOOKMA_VOICE_MAX_TOKENS=200

# The agent that does the work: claude (Claude Code, the default) or codex (Codex CLI).
# LOOKMA_EXECUTOR=codex

# The Claude Code model, e.g. opus.
# LOOKMA_MODEL=opus

# Claude Code's permission mode; default gives more cards.
# LOOKMA_PERMISSION_MODE=default

# The Codex model. Unset, Codex picks its default.
# LOOKMA_CODEX_MODEL=

# 1: Codex's Fast speed tier. Quicker replies, and it uses more of your ChatGPT plan.
# LOOKMA_CODEX_FAST=1
